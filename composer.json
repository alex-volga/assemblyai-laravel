{
    "name": "alex-volga/assemblyai-laravel",
    "description": "AssemblyAI Speech-to-Text and Audio Intelligence SDK integration for Laravel (v11, v12, v13)",
    "keywords": [
        "laravel",
        "assemblyai",
        "speech-to-text",
        "transcription",
        "audio-intelligence",
        "lemur",
        "ai",
        "sdk"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleksandr Volha",
            "email": "v.alex.lg@gmail.com",
            "homepage": "https://github.com/alex-volga",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/alex-volga/assemblyai-laravel",
    "support": {
        "issues": "https://github.com/alex-volga/assemblyai-laravel/issues",
        "source": "https://github.com/alex-volga/assemblyai-laravel"
    },
    "require": {
        "php": ">=8.3",
        "alex-volga/assemblyai-php": "^1.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AssemblyAI\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AssemblyAI\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AssemblyAI\\Laravel\\AssemblyAIServiceProvider"
            ],
            "aliases": {
                "AssemblyAI": "AssemblyAI\\Laravel\\Facades\\AssemblyAI"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
